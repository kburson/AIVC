# Copy to apps/web/.env.local, or export these server-only values before root npm run dev/start.
# Root .env is not loaded by scripts/dev.mjs; Next runs with apps/web as its project root.
# Empty provider values keep the affected capability unavailable until explicitly configured.
AIVC_MODE=live
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=
DEEPGRAM_TTS_MODEL=
RETRIEVAL_BASE_URL=http://127.0.0.1:3001
CLAUDE_WEB_SEARCH=enabled
CLAUDE_WEB_SEARCH_TOOL_VERSION=web_search_20250305
BFF_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BFF_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
# Explicit admission/deadline values are required; malformed or missing values fail closed.
SPEECH_CHARS_PER_SECOND=14
TURN_TIMEOUT_MS=60000
RETRIEVAL_TIMEOUT_MS=5000
SPEECH_TIMEOUT_MS=20000
